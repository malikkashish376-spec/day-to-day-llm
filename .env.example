# ---- LLM provider -------------------------------------------------------
# mock   : deterministic, no model, no network (default; used by tests & CI)
# ollama : local inference, private, recommended for the demo
# openai : any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, LM Studio)
DAYTODAY_LLM_PROVIDER=mock
DAYTODAY_LLM_MODEL=llama3.1:8b
DAYTODAY_LLM_TEMPERATURE=0.2

# Ollama
OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible (never commit a real key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Storage ------------------------------------------------------------
DAYTODAY_DB=./data/daytoday.db

# ---- Agent behaviour ----------------------------------------------------
DAYTODAY_MAX_TOOL_ROUNDS=4
DAYTODAY_RETRIEVAL_K=4
DAYTODAY_MEMORY_WINDOW=8
DAYTODAY_TIMEOUT_S=60

# ---- Locale -------------------------------------------------------------
DAYTODAY_CURRENCY=INR
DAYTODAY_TIMEZONE=Asia/Kolkata
